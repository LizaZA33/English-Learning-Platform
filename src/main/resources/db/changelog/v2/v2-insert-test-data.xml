    <changeSet id="v2-005-insert-modules" author="admin">
        <comment>Создание учебных модулей</comment>
        <insert tableName="modules">
            <column name="name" value="Базовый уровень"/>
        </insert>
        <insert tableName="modules">
            <column name="name" value="Средний уровень"/>
        </insert>
        <insert tableName="modules">
            <column name="name" value="Продвинутый уровень"/>
        </insert>
        <rollback>
            <delete tableName="modules">
                <where>name IN ('Базовый уровень', 'Средний уровень', 'Продвинутый уровень')</where>
            </delete>
        </rollback>
