<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="14-add-index-user-email" author="dev">
        <comment>Индекс для быстрого поиска пользователя по email</comment>
        <createIndex tableName="users" indexName="idx_users_email">
            <column name="email"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="users" indexName="idx_users_email"/>
        </rollback>
    </changeSet>

    <changeSet id="15-add-index-teacher-name" author="dev">
        <comment>Индекс для поиска учителя по имени и фамилии</comment>
        <createIndex tableName="teacher" indexName="idx_teacher_name">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="teacher" indexName="idx_teacher_name"/>
        </rollback>
    </changeSet>

    <changeSet id="16-add-index-student-name" author="dev">
        <comment>Индекс для поиска студента по имени и фамилии</comment>
        <createIndex tableName="student" indexName="idx_student_name">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="student" indexName="idx_student_name"/>
        </rollback>
    </changeSet>

    <changeSet id="17-add-index-group-teacher" author="dev">
        <comment>Индекс для поиска групп по учителю</comment>
        <createIndex tableName="course_group" indexName="idx_group_teacher">
            <column name="teacher_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="course_group" indexName="idx_group_teacher"/>
        </rollback>
    </changeSet>

    <changeSet id="18-add-index-lesson-teacher" author="dev">
        <comment>Индекс для поиска уроков по учителю</comment>
        <createIndex tableName="lesson" indexName="idx_lesson_teacher">
            <column name="teacher_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="lesson" indexName="idx_lesson_teacher"/>
        </rollback>
    </changeSet>

    <changeSet id="19-add-index-lesson-owner" author="dev">
        <comment>Индекс для поиска личных уроков пользователя</comment>
        <createIndex tableName="lesson" indexName="idx_lesson_owner">
            <column name="owner_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="lesson" indexName="idx_lesson_owner"/>
        </rollback>
    </changeSet>

    <changeSet id="20-add-index-lecture-module" author="dev">
        <comment>Индекс для поиска лекций по модулю</comment>
        <createIndex tableName="lecture" indexName="idx_lecture_module">
            <column name="module_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="lecture" indexName="idx_lecture_module"/>
        </rollback>
    </changeSet>

    <changeSet id="21-add-index-flashcard-lesson" author="dev">
        <comment>Индекс для поиска карточек по уроку</comment>
        <createIndex tableName="flashcard" indexName="idx_flashcard_lesson">
            <column name="lesson_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="flashcard" indexName="idx_flashcard_lesson"/>
        </rollback>
    </changeSet>
</databaseChangeLog>