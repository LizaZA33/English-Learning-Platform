<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="v6-001-fix-admin-password" author="admin">
        <comment>Исправление пароля администратора (пароль: password)</comment>
        <!-- Правильный BCrypt хеш для пароля "password" -->
        <update tableName="users">
            <column name="password" value="$2a$10$dXJ3SW6G7P50lGmMkkmwe.20cQQubK3.HZWzG3YB1tlRy.fqvM/BG"/>
            <where>email = 'admin@platform.com'</where>
        </update>
    </changeSet>

    <changeSet id="v6-002-ensure-admin-has-admin-role" author="admin">
        <comment>Убедиться что admin имеет роль ADMIN</comment>
        <!-- Удаляем старую запись если есть -->
        <delete tableName="user_roles">
            <where>user_id = (SELECT id FROM users WHERE email = 'admin@platform.com')</where>
        </delete>
        <!-- Добавляем обе роли -->
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'admin@platform.com')"/>
            <column name="role_name" value="USER"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'admin@platform.com')"/>
            <column name="role_name" value="ADMIN"/>
        </insert>
    </changeSet>

    <changeSet id="v6-003-ensure-teacher-roles" author="admin">
        <comment>Убедиться что teacher имеет правильные роли</comment>
        <delete tableName="user_roles">
            <where>user_id = (SELECT id FROM users WHERE email = 'teacher@platform.com')</where>
        </delete>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'teacher@platform.com')"/>
            <column name="role_name" value="USER"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'teacher@platform.com')"/>
            <column name="role_name" value="TEACHER"/>
        </insert>
    </changeSet>

    <changeSet id="v6-004-ensure-student-roles" author="admin">
        <comment>Убедиться что student имеет правильные роли</comment>
        <delete tableName="user_roles">
            <where>user_id = (SELECT id FROM users WHERE email = 'student@platform.com')</where>
        </delete>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'student@platform.com')"/>
            <column name="role_name" value="USER"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'student@platform.com')"/>
            <column name="role_name" value="STUDENT"/>
        </insert>
    </changeSet>

    <changeSet id="v6-005-ensure-user-roles" author="admin">
        <comment>Убедиться что user имеет правильные роли</comment>
        <delete tableName="user_roles">
            <where>user_id = (SELECT id FROM users WHERE email = 'user@platform.com')</where>
        </delete>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE email = 'user@platform.com')"/>
            <column name="role_name" value="USER"/>
        </insert>
    </changeSet>

    <changeSet id="v6-006-fix-passwords-for-all" author="admin">
        <comment>Исправление паролей для всех тестовых пользователей</comment>
        <update tableName="users">
            <column name="password" value="$2a$10$dXJ3SW6G7P50lGmMkkmwe.20cQQubK3.HZWzG3YB1tlRy.fqvM/BG"/>
            <where>email IN ('teacher@platform.com', 'student@platform.com', 'user@platform.com')</where>
        </update>
    </changeSet>

</databaseChangeLog>